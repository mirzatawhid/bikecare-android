rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }

    function validBike(bikeId) {
      let bike = request.resource.data;
      return bike.keys().hasAll(['id', 'brand', 'model', 'year', 'registrationNumber',
          'initialOdometer', 'currentOdometer', 'imageUrl', 'createdAt', 'updatedAt', 'isActive'])
        && bike.keys().hasOnly(['id', 'brand', 'model', 'year', 'registrationNumber',
          'initialOdometer', 'currentOdometer', 'imageUrl', 'createdAt', 'updatedAt', 'isActive'])
        && bike.id == bikeId && bikeId.size() > 0 && bikeId.size() <= 128
        && bike.brand is string && bike.brand.size() > 0 && bike.brand.size() <= 100
        && bike.model is string && bike.model.size() > 0 && bike.model.size() <= 100
        && bike.year is int && bike.year >= 1885 && bike.year <= 2100
        && bike.registrationNumber is string && bike.registrationNumber.size() <= 50
        && bike.initialOdometer is int && bike.initialOdometer >= 0
        && bike.currentOdometer is int && bike.currentOdometer >= bike.initialOdometer
        && bike.currentOdometer <= 10000000
        && (bike.imageUrl == null || (bike.imageUrl is string
          && bike.imageUrl.size() <= 2048 && bike.imageUrl.matches('https://.*')))
        && bike.createdAt is timestamp && bike.updatedAt is timestamp
        && bike.updatedAt >= bike.createdAt
        && bike.isActive is bool;
    }

    function validMaintenance(uid, logId) {
      let log = request.resource.data;
      return logId.size() > 0 && logId.size() <= 128
        && log.keys().hasAll(['bikeId', 'title', 'category', 'serviceType', 'date',
          'odometer', 'cost', 'provider', 'description', 'nextServiceOdometer',
          'nextServiceDate', 'receiptUrl', 'createdAt'])
        && log.keys().hasOnly(['bikeId', 'title', 'category', 'serviceType', 'date',
          'odometer', 'cost', 'provider', 'description', 'nextServiceOdometer',
          'nextServiceDate', 'receiptUrl', 'createdAt'])
        && log.bikeId is string && log.bikeId.size() > 0 && log.bikeId.size() <= 128
        && log.bikeId.matches('[^/]+') && log.bikeId != '.' && log.bikeId != '..'
        && exists(/databases/$(database)/documents/users/$(uid)/bikes/$(log.bikeId))
        && get(/databases/$(database)/documents/users/$(uid)/bikes/$(log.bikeId)).data.isActive == true
        && log.title is string && log.title.size() > 0 && log.title.size() <= 100
        && log.category in ['ENGINE', 'BRAKES', 'TIRES', 'ELECTRICAL', 'GENERAL']
        && log.serviceType in ['PREVENTIVE', 'REPAIR', 'INSPECTION']
        && log.date is timestamp && log.date >= timestamp.date(1970, 1, 1)
        && log.date <= timestamp.date(2100, 1, 1)
        && log.odometer is int && log.odometer >= 0 && log.odometer <= 10000000
        && log.cost is int && log.cost >= 0 && log.cost <= 1000000000
        && log.provider is string && log.provider.size() <= 100
        && log.description is string && log.description.size() <= 1000
        && (log.nextServiceOdometer == null ||
          (log.nextServiceOdometer is int && log.nextServiceOdometer >= log.odometer
            && log.nextServiceOdometer <= 10000000))
        && (log.nextServiceDate == null ||
          (log.nextServiceDate is timestamp && log.nextServiceDate >= log.date
            && log.nextServiceDate <= timestamp.date(2100, 1, 1)))
        && log.receiptUrl == null
        && log.createdAt is timestamp && log.createdAt == request.time;
    }

    function validFuelLog(uid, logId) {
      let log = request.resource.data;
      return logId.size() > 0 && logId.size() <= 128
        && log.keys().hasAll(['bikeId', 'date', 'odometer', 'fuelType', 'quantity',
          'pricePerLiter', 'totalCost', 'station', 'fullTank', 'notes', 'createdAt'])
        && log.keys().hasOnly(['bikeId', 'date', 'odometer', 'fuelType', 'quantity',
          'pricePerLiter', 'totalCost', 'station', 'fullTank', 'notes', 'createdAt'])
        && log.bikeId is string && log.bikeId.size() > 0 && log.bikeId.size() <= 128
        && log.bikeId.matches('[^/]+') && log.bikeId != '.' && log.bikeId != '..'
        && exists(/databases/$(database)/documents/users/$(uid)/bikes/$(log.bikeId))
        && get(/databases/$(database)/documents/users/$(uid)/bikes/$(log.bikeId)).data.isActive == true
        && log.date is timestamp && log.date >= timestamp.date(1970, 1, 1)
        && log.date <= timestamp.date(2100, 1, 1)
        && log.odometer is int && log.odometer >= 0 && log.odometer <= 10000000
        && log.fuelType is string && log.fuelType.size() > 0 && log.fuelType.size() <= 50
        && log.quantity is number && log.quantity > 0 && log.quantity <= 1000
        && log.pricePerLiter is number && log.pricePerLiter > 0 && log.pricePerLiter <= 100000
        && log.totalCost is number && log.totalCost > 0 && log.totalCost <= 100000000
        && log.totalCost >= log.quantity * log.pricePerLiter - 0.011
        && log.totalCost <= log.quantity * log.pricePerLiter + 0.011
        && log.station is string && log.station.size() <= 100
        && log.fullTank is bool
        && log.notes is string && log.notes.size() <= 1000
        && log.createdAt is timestamp && log.createdAt == request.time;
    }

    match /users/{uid} {
      allow read: if isVerifiedOwner(uid);
      // Profile writes and future collections need their own schema before enabling.
      match /bikes/{bikeId} {
        allow read: if isVerifiedOwner(uid);
        allow create: if isVerifiedOwner(uid) && validBike(bikeId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isVerifiedOwner(uid) && validBike(bikeId)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.initialOdometer == resource.data.initialOdometer
          && request.resource.data.updatedAt == request.time;
        allow delete: if isVerifiedOwner(uid);
      }
      match /maintenanceLogs/{logId} {
        allow read: if isVerifiedOwner(uid);
        allow create: if isVerifiedOwner(uid) && validMaintenance(uid, logId);
      }
      match /fuelLogs/{logId} {
        allow read: if isVerifiedOwner(uid);
        allow create: if isVerifiedOwner(uid) && validFuelLog(uid, logId);
      }
    }
    // Unmatched paths are denied. Do not add a permissive catch-all rule.
  }
}
